---
import { label, reveal, t, text } from '../../engine';
import Icon from '../Icon.astro';
import ProductVisual from '../ProductVisual.astro';
import { products } from '../../lib/products';

interface Props {
  /** Seconds each product stays before the next comes on its own. */
  cycle?: number;
}

const { cycle = 6 } = Astro.props;
---

<section class="band pt" id="products">
  <div class="shell stack">
    <div class="head" {...reveal()}>
      <h2 {...text('home.products.title')}>{t('home.products.title')}</h2>
    </div>

    <div class="pt__stage" data-tabs data-cycle={cycle * 1000} data-exit="420" {...reveal()}>
      <div class="pt__tabs" role="group" {...label('home.products.label')}>
        <div class="pt__picks">
          {products.map((p, i) => (
            <button type="button" class="pt__tab" aria-pressed={i === 0 ? 'true' : 'false'} data-tab={p.key}>
              <Icon name={p.icon} class="pt__tab-icon" />
              <span {...text(`products.${p.key}.short`)}>{t(`products.${p.key}.short`)}</span>
              <span class="pt__time" aria-hidden="true"><span data-time></span></span>
            </button>
          ))}
        </div>
        <button type="button" class="pt__hold" aria-pressed="false" data-hold {...label('home.products.pause')}>
          <Icon name="pause" class="pt__pause" />
          <Icon name="play" class="pt__play" />
        </button>
      </div>

      <div class="pt__card" data-frame>
        {products.map((p, i) => (
          <div class="pt__pane" data-pane={p.key} hidden={i !== 0}>
            <div class="pt__copy">
              <span class="pt__icon" aria-hidden="true"><Icon name={p.icon} /></span>
              <h3 class="pt__name" {...text(`products.${p.key}.name`)}>{t(`products.${p.key}.name`)}</h3>
              <p class="pt__tag" {...text(`products.${p.key}.tag`)}>{t(`products.${p.key}.tag`)}</p>
              <p class="pt__text" {...text(`products.${p.key}.text`)}>{t(`products.${p.key}.text`)}</p>
              <a href={`/products/${p.slug}`} class="link pt__more">
                <span {...text('common.learn')}>{t('common.learn')}</span>
                <Icon name="arrow" />
              </a>
            </div>
            <ProductVisual k={p.key} class="pt__visual" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pt {
    overflow: clip;
  }

  .pt__stage {
    display: grid;
    gap: 1.25rem;
  }

  .pt__tabs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  /* on a phone the tabs scroll sideways rather than wrap */
  .pt__picks {
    display: flex;
    gap: 0.25rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pt__tab {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.5rem 1rem 0.65rem;
    border: 0;
    background: none;
    color: var(--mute);
    font-size: 1.05rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.25s var(--ease);
  }

  .pt__tab:hover {
    color: var(--ink-2);
  }

  .pt__tab[aria-pressed='true'] {
    color: var(--ink);
  }

  .pt__tab-icon {
    width: 1.3rem;
    height: 1.3rem;
  }

  .pt__tab[aria-pressed='true'] .pt__tab-icon {
    color: var(--accent-ink);
    animation: pt-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* the tab's time: a track under the label, filled with the aurora line */
  .pt__time {
    position: absolute;
    inset: auto 1rem 0.2rem;
    height: 2px;
    border-radius: 999px;
    background: var(--edge);
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }

  .pt__time span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(var(--aurora-3)), rgb(var(--aurora-2)), rgb(var(--aurora-1)));
    transform-origin: left;
    scale: 0 1;
  }

  .pt__tab[aria-pressed='true'] .pt__time {
    opacity: 1;
  }

  /* with the timer off, the pressed tab keeps a full line */
  [data-cycle-state='off'] .pt__tab[aria-pressed='true'] .pt__time span,
  html:not(.js) .pt__tab[aria-pressed='true'] .pt__time span {
    scale: 1 1;
  }

  .pt__hold {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--edge-strong);
    border-radius: 50%;
    background: var(--sheet);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .pt__hold:hover {
    background: var(--sheet-2);
    color: var(--ink);
  }

  .pt__hold svg {
    width: 1rem;
    height: 1rem;
  }

  .pt__hold[aria-pressed='true'] .pt__pause,
  .pt__hold[aria-pressed='false'] .pt__play {
    display: none;
  }

  /* the panes share one cell, so the one leaving and the one arriving can cross */
  .pt__card {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: clip;
    border-radius: calc(var(--radius) + 4px);
    border: 1px solid color-mix(in oklab, var(--accent) 45%, var(--edge-strong));
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(var(--aurora-3) / 0.1), transparent 60%),
      var(--ground-2);
  }

  .pt__pane {
    grid-area: 1 / 1;
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 0.75rem + 2.5vw, 3rem);
  }

  /* where the next product comes from and the last one goes: forward from the right, back from the left */
  .pt__stage {
    --from: 3rem;
  }

  .pt__stage[data-dir='prev'] {
    --from: -3rem;
  }

  .pt__pane[data-leaving] {
    pointer-events: none;
    animation: pt-out 0.42s var(--ease) both;
  }

  @keyframes pt-out {
    to {
      opacity: 0;
      translate: calc(var(--from) * -1) 0;
      filter: blur(6px);
    }
  }

  /* the arriving product plays in, once the section is in view: the words rise one after another
     and the picture slides in from the side it comes from; the picture plays its own parts in */
  .pt__stage:not([data-reveal-wait]) .pt__pane:not([hidden], [data-leaving]) .pt__copy > * {
    animation: pt-rise 0.6s var(--ease) both;
  }

  .pt__stage:not([data-reveal-wait]) .pt__pane:not([hidden], [data-leaving]) .pt__copy > :nth-child(2) {
    animation-delay: 0.06s;
  }

  .pt__stage:not([data-reveal-wait]) .pt__pane:not([hidden], [data-leaving]) .pt__copy > :nth-child(3) {
    animation-delay: 0.12s;
  }

  .pt__stage:not([data-reveal-wait]) .pt__pane:not([hidden], [data-leaving]) .pt__copy > :nth-child(4) {
    animation-delay: 0.18s;
  }

  .pt__stage:not([data-reveal-wait]) .pt__pane:not([hidden], [data-leaving]) .pt__copy > :nth-child(5) {
    animation-delay: 0.24s;
  }

  .pt__stage:not([data-reveal-wait]) .pt__pane:not([hidden], [data-leaving]) .pt__copy > .pt__icon {
    animation-name: pt-icon;
    animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .pt__stage:not([data-reveal-wait]) .pt__pane:not([hidden], [data-leaving]) :global(.pv) {
    animation: pt-visual 0.75s var(--ease) 0.08s both;
  }

  @keyframes pt-rise {
    from {
      opacity: 0;
      translate: 0 14px;
      filter: blur(4px);
    }
  }

  @keyframes pt-icon {
    from {
      opacity: 0;
      scale: 0.5;
      rotate: -14deg;
    }
  }

  @keyframes pt-visual {
    from {
      opacity: 0;
      translate: var(--from) 0;
      scale: 0.96;
      filter: blur(8px);
    }
  }

  @keyframes pt-pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
  }

  .pt__copy {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.9rem;
  }

  .pt__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 14px;
    background: linear-gradient(135deg, rgb(var(--aurora-3) / 0.25), rgb(var(--aurora-2) / 0.14));
    border: 1px solid var(--edge-strong);
    color: var(--accent-ink);
  }

  .pt__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .pt__name {
    font-size: var(--step-3);
  }

  .pt__tag {
    color: var(--accent-ink);
    font-weight: 500;
  }

  .pt__text {
    color: var(--ink-2);
    font-size: var(--step-1);
    max-width: 26rem;
  }

  .pt__more {
    margin-top: 0.4rem;
    color: var(--accent-ink);
  }

  html:not(.js) .pt__hold,
  html:not(.js) .pt__time {
    display: none;
  }

  /* without scripts every product shows, one under another */
  html:not(.js) .pt__pane[hidden] {
    display: grid;
    border-top: 1px solid var(--edge);
  }

  @media (min-width: 64rem) {
    .pt__pane {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      gap: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt__stage .pt__pane,
    .pt__stage .pt__pane * {
      animation: none;
    }
  }
</style>

<script>
  import { wireTabs } from '../../lib/tabs';

  wireTabs();
</script>
