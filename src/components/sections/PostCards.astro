---
import { Image } from 'astro:assets';
import { reveal, t, text } from '../../engine';
import { posts } from '../../lib/posts';
import Icon from '../Icon.astro';

interface Props {
  /** 2 where the cards follow the page's h1 directly. */
  level?: 2 | 3;
  except?: string;
  /** Only the newest this many. */
  limit?: number;
}

const { except, level = 3, limit } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const list = posts.filter((p) => p.key !== except).slice(0, limit);
---

<ul class="posts" role="list">
  {list.map((p, i) => (
    <li class="posts__cell" {...reveal()} style={`--d: ${i * 0.08}s`}>
      <a href={`/blog/${p.slug}`} class="posts__card">
        <div class="posts__cover" aria-hidden="true">
          <Image
            src={p.cover}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(min-width: 80rem) 25rem, (min-width: 62rem) 33vw, (min-width: 42rem) 50vw, 100vw"
            class="posts__img"
          />
          <span class="posts__tag mono" {...text(`blog.posts.${p.key}.tag`)}>{t(`blog.posts.${p.key}.tag`)}</span>
        </div>
        <p class="posts__meta">
          <time datetime={p.date} {...text(`blog.posts.${p.key}.date`)}>{t(`blog.posts.${p.key}.date`)}</time>
        </p>
        <H class="posts__title" {...text(`blog.posts.${p.key}.title`)}>{t(`blog.posts.${p.key}.title`)}</H>
        <p class="posts__lede" {...text(`blog.posts.${p.key}.lede`)}>{t(`blog.posts.${p.key}.lede`)}</p>
        <span class="link"><span {...text('common.read')}>{t('common.read')}</span><Icon name="arrow" /></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 2rem 1.25rem;
    margin: 0;
  }

  .posts__cell {
    display: grid;
    min-width: 0;
  }

  .posts__card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 0.75rem;
    align-content: start;
  }

  .posts__cover {
    position: relative;
    display: flex;
    align-items: end;
    aspect-ratio: 16 / 10;
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--edge);
    overflow: hidden;
    background-color: var(--sheet);
  }

  .posts__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1.2s var(--ease);
  }

  .posts__card:hover .posts__img {
    scale: 1.04;
  }

  .posts__tag {
    position: relative;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--panel-bg);
    font-size: 0.78rem;
  }

  .posts__meta {
    color: var(--mute);
    font-size: 0.86rem;
  }

  .posts__title {
    font-size: var(--step-1);
  }

  .posts__card:hover .posts__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .posts__lede {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
</style>
