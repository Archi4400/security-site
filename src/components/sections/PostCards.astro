---
import { reveal, t, text } from '../../engine';
import { posts } from '../../lib/posts';
import Icon from '../Icon.astro';

interface Props {
  /** 2 where the cards follow the page's h1 directly. */
  level?: 2 | 3;
  except?: string;
}

const { except, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const list = posts.filter((p) => p.key !== except);
---

<ul class="posts" role="list">
  {list.map((p, i) => (
    <li class="posts__cell" {...reveal()} style={`--d: ${i * 0.08}s`}>
      <a href={`/blog/${p.slug}`} class="posts__card">
        <div class:list={['posts__cover', `posts__cover--${p.tone}`]} aria-hidden="true">
          <span class="posts__tag mono" {...text(`blog.posts.${p.key}.tag`)}>{t(`blog.posts.${p.key}.tag`)}</span>
        </div>
        <p class="posts__meta">
          <time datetime={p.date} {...text(`blog.posts.${p.key}.date`)}>{t(`blog.posts.${p.key}.date`)}</time>
        </p>
        <H class="posts__title" {...text(`blog.posts.${p.key}.title`)}>{t(`blog.posts.${p.key}.title`)}</H>
        <p class="posts__lede" {...text(`blog.posts.${p.key}.lede`)}>{t(`blog.posts.${p.key}.lede`)}</p>
        <span class="link"><span {...text('common.read')}>{t('common.read')}</span><Icon name="arrow" /></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 2rem 1.25rem;
    margin: 0;
  }

  .posts__cell {
    display: grid;
    min-width: 0;
  }

  .posts__card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 0.75rem;
    align-content: start;
  }

  .posts__cover {
    position: relative;
    display: flex;
    align-items: end;
    aspect-ratio: 16 / 10;
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--edge);
    overflow: hidden;
    background-color: var(--sheet);
    background-size: 140% 140%;
    background-position: 0% 100%;
    transition: background-position 1.2s var(--ease);
  }

  .posts__card:hover .posts__cover {
    background-position: 60% 40%;
  }

  .posts__cover--amber {
    background-image:
      radial-gradient(50% 60% at 15% 100%, rgb(var(--aurora-1) / 0.85), transparent 70%),
      radial-gradient(60% 70% at 70% 90%, rgb(var(--aurora-2) / 0.55), transparent 70%);
  }

  .posts__cover--violet {
    background-image:
      radial-gradient(55% 65% at 40% 100%, rgb(var(--aurora-2) / 0.8), transparent 70%),
      radial-gradient(50% 60% at 90% 60%, rgb(var(--aurora-3) / 0.6), transparent 70%);
  }

  .posts__cover--blue {
    background-image:
      radial-gradient(60% 70% at 80% 100%, rgb(var(--aurora-3) / 0.85), transparent 70%),
      radial-gradient(40% 50% at 10% 90%, rgb(var(--aurora-1) / 0.45), transparent 70%);
  }

  .posts__tag {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--panel-bg);
    font-size: 0.78rem;
  }

  .posts__meta {
    color: var(--mute);
    font-size: 0.86rem;
  }

  .posts__title {
    font-size: var(--step-1);
  }

  .posts__card:hover .posts__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .posts__lede {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
</style>
