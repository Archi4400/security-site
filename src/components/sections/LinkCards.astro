---
import { reveal, t, text } from '../../engine';
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';

export interface LinkCard {
  href: string;
  icon: IconName;
  titleKey: string;
  textKey: string;
}

interface Props {
  items: LinkCard[];
  /** 2 where the cards follow the page's h1 directly. */
  level?: 2 | 3;
}

const { items, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---

<ul class="tiles sol" role="list" style="--tile: 19rem">
  {items.map((item, i) => (
    <li class="sol__cell" {...reveal()} style={`--d: ${(i % 3) * 0.07}s`}>
      <a href={item.href} class="sol__card card">
        <Icon name={item.icon} class="sol__icon" />
        <H class="sol__title" {...text(item.titleKey)}>{t(item.titleKey)}</H>
        <p class="sol__text" {...text(item.textKey)}>{t(item.textKey)}</p>
        <Icon name="arrow" class="sol__go" />
      </a>
    </li>
  ))}
</ul>

<style>
  .sol__cell {
    display: grid;
    min-width: 0;
  }

  @media (min-width: 72rem) {
    .sol:has(> :nth-child(4):last-child) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .sol__card {
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.8rem;
    padding: 1.6rem;
  }

  .sol__card::after {
    content: '';
    position: absolute;
    inset: auto -20% -60% -20%;
    height: 80%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(var(--aurora-3) / 0.35), transparent);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .sol__card:hover::after {
    opacity: 1;
  }

  .sol__icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--accent-ink);
  }

  .sol__title {
    font-size: var(--step-2);
  }

  .sol__text {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .sol__go {
    width: 1.2rem;
    height: 1.2rem;
    transition: translate 0.25s var(--ease);
  }

  .sol__card:hover .sol__go {
    translate: 4px 0;
  }
</style>
