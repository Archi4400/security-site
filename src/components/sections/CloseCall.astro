---
import { reveal, t, text } from '../../engine';
import { REGISTER } from '../../brand';
import Aurora from '../Aurora.astro';
import Icon from '../Icon.astro';
---

<section class="close">
  <Aurora intensity={0.7} scale={14} lean={0.04} fps={30} rise={1.1} />
  <div class="shell close__wrap" {...reveal()}>
    <h2 class="close__title" {...text('close.title')}>{t('close.title')}</h2>
    <p class="close__lede lede" {...text('close.lede')}>{t('close.lede')}</p>
    <div class="close__actions">
      <a href={REGISTER} class="btn btn--solid"><span {...text('common.cta')}>{t('common.cta')}</span><Icon name="out" /></a>
      <a href="/contact" class="btn btn--line"><span {...text('common.contact')}>{t('common.contact')}</span></a>
    </div>
  </div>
</section>

<style>
  .close {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 3rem + 8vw, 10rem);
    text-align: center;
  }

  .close::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(180deg, var(--ground) 0%, transparent 45%);
  }

  .close__wrap {
    display: grid;
    justify-items: center;
    gap: 1.3rem;
  }

  .close__title {
    max-width: 18ch;
    font-size: var(--step-4);
  }

  .close__lede {
    max-width: 40rem;
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
