---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/sections/PageHead.astro';
import LinkCards from '../../components/sections/LinkCards.astro';
import CloseCall from '../../components/sections/CloseCall.astro';
import SolutionVisual from '../../components/SolutionVisual.astro';
import { reveal, t, text } from '../../engine';
import { solutionCards, solutions, type Solution } from '../../lib/solutions';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { solution: s } }));
}

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const k = solution.key;
const notes = [
  { head: 'common.howWorks', body: `solutions.${k}.how` },
  { head: 'common.inPractice', body: `solutions.${k}.example` },
  { head: 'common.limit', body: `solutions.${k}.limit` },
];
---

<Layout metaKey={`meta.${k}`} path={`/solutions/${solution.slug}`}>
  <PageHead titleKey={`solutions.${k}.title`} ledeKey={`solutions.${k}.text`} kickerKey="nav.solutions" />

  <section class="band sd">
    <div class="shell sd__grid">
      <div class="sd__notes">
        {notes.map((n, i) => (
          <article class:list={['sd__note', i === 2 && 'sd__note--limit']} {...reveal()} style={`--d: ${i * 0.08}s`}>
            <h2 class="sd__head" {...text(n.head)}>{t(n.head)}</h2>
            <p {...text(n.body)}>{t(n.body)}</p>
          </article>
        ))}
      </div>
      <div class="sd__visual" {...reveal()}>
        <SolutionVisual k={k} data-lean style="--lean-amount: 0.5" />
      </div>
    </div>
  </section>

  <section class="band sd-more">
    <div class="shell sd-more__wrap">
      <h2 class="sd-more__title" {...text('common.related')}>{t('common.related')}</h2>
      <LinkCards items={solutionCards(k)} />
    </div>
  </section>

  <CloseCall />
</Layout>

<style>
  .sd__grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .sd__notes {
    display: grid;
    gap: 1rem;
  }

  .sd__note {
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--edge);
    background: var(--sheet);
  }

  .sd__note p {
    color: var(--ink-2);
  }

  .sd__note--limit {
    border-style: dashed;
    border-color: var(--edge-strong);
    background: none;
  }

  .sd__head {
    font-size: var(--step-1);
  }

  .sd__visual {
    min-width: 0;
  }

  .sd-more {
    background: var(--ground-2);
    border-top: 1px solid var(--edge);
  }

  .sd-more__wrap {
    display: grid;
    gap: 2rem;
  }

  .sd-more__title {
    font-size: var(--step-3);
  }

  @media (min-width: 64rem) {
    .sd__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
    }

    .sd__visual {
      position: sticky;
      top: calc(var(--pinned-offset) + 2rem);
    }
  }
</style>
