---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/sections/PageHead.astro';
import LinkCards from '../../components/sections/LinkCards.astro';
import CloseCall from '../../components/sections/CloseCall.astro';
import { solutionCards } from '../../lib/solutions';
---

<Layout metaKey="meta.solutions" path="/solutions">
  <PageHead titleKey="solutions.head.title" ledeKey="solutions.head.lede" kickerKey="nav.solutions" />
  <section class="band">
    <div class="shell">
      <LinkCards items={solutionCards()} level={2} />
    </div>
  </section>
  <CloseCall />
</Layout>
