import SolutionCards from '../../components/sections/SolutionCards.astro';
import CloseCall from '../../components/sections/CloseCall.astro';
---

<Layout metaKey="meta.solutions" path="/solutions">
  <PageHead titleKey="solutions.head.title" ledeKey="solutions.head.lede" kickerKey="nav.solutions" />
  <section class="band">
    <div class="shell">
      <SolutionCards withPortal level={2} />
