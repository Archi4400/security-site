---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/sections/PageHead.astro';
import CloseCall from '../components/sections/CloseCall.astro';
import Icon from '../components/Icon.astro';
import ProductVisual from '../components/ProductVisual.astro';
import { label, reveal, t, text } from '../engine';
import { en } from '../i18n/locales/en';
import { DEMO } from '../components/header/navRoutes';
import { products } from '../lib/products';
---

<Layout metaKey="meta.pricing" path="/pricing">
  <PageHead titleKey="pricing.head.title" ledeKey="pricing.head.lede" />

  <section class="band pr">
    <div class="shell pr__stage" data-tabs data-hash {...reveal()}>
      <div class="pr__tabs" role="group" {...label('pricing.label')}>
        {products.map((p, i) => (
          <button type="button" class="pr__tab" aria-pressed={i === 0 ? 'true' : 'false'} data-tab={p.key}>
            <Icon name={p.icon} />
            <span {...text(`products.${p.key}.short`)}>{t(`products.${p.key}.short`)}</span>
          </button>
        ))}
      </div>

      {products.map((p, i) => (
        <div class="pr__pane" data-pane={p.key} id={p.key} hidden={i !== 0}>
          <div class="pr__box">
            <span class="pr__corner pr__corner--tl" aria-hidden="true"></span>
            <span class="pr__corner pr__corner--tr" aria-hidden="true"></span>
            <span class="pr__corner pr__corner--bl" aria-hidden="true"></span>
            <span class="pr__corner pr__corner--br" aria-hidden="true"></span>

            <div class="pr__top">
              <div class="pr__intro">
                <h2 class="pr__name" {...text(`products.${p.key}.name`)}>{t(`products.${p.key}.name`)}</h2>
                <p class="pr__tag" {...text(`products.${p.key}.tag`)}>{t(`products.${p.key}.tag`)}</p>
                <p class="pr__lede" {...text(`products.${p.key}.lede`)}>{t(`products.${p.key}.lede`)}</p>
                <a href={`/products/${p.slug}`} class="link pr__more">
                  <span {...text('pricing.product')}>{t('pricing.product')}</span>
                  <Icon name="arrow" />
                </a>
              </div>
              <ProductVisual k={p.key} class="pr__visual" />
            </div>

            <div class="pr__cells">
              <div class="pr__cell">
                <h3 class="pr__label" {...text('products.built')}>{t('products.built')}</h3>
                <ul class="pr__chips" role="list">
                  {en.products[p.key].built.map((_, j) => (
                    <li {...text(`products.${p.key}.built.${j}`)}>{t(`products.${p.key}.built.${j}`)}</li>
                  ))}
                </ul>
                <h3 class="pr__label" {...text('products.helps')}>{t('products.helps')}</h3>
                <ul class="pr__points" role="list">
                  {en.products[p.key].points.map((_, j) => (
                    <li>
                      <Icon name="check" class="pr__check" />
                      <span {...text(`products.${p.key}.points.${j}.title`)}>{t(`products.${p.key}.points.${j}.title`)}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pr__cell pr__cell--price">
                <p class="pr__price" {...text('pricing.onRequest')}>{t('pricing.onRequest')}</p>
                <p class="pr__plan" {...text('pricing.plan')}>{t('pricing.plan')}</p>
                <a href={DEMO} class="btn btn--solid pr__cta"><span {...text('common.cta')}>{t('common.cta')}</span></a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CloseCall />
</Layout>

<style>
  .pr__stage {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* one pill of products, centred; on a phone it scrolls sideways */
  .pr__tabs {
    justify-self: center;
    display: flex;
    gap: 0.25rem;
    max-width: 100%;
    padding: 0.35rem;
    border-radius: 999px;
    border: 1px solid var(--edge-strong);
    background: var(--sheet);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pr__tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .pr__tab svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .pr__tab:hover {
    color: var(--ink);
  }

  .pr__tab[aria-pressed='true'] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .pr__pane {
    scroll-margin-top: var(--pinned-offset);
  }

  .pr__pane:not([hidden]) {
    animation: pane-in 0.45s var(--ease);
  }

  @keyframes pane-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  .pr__box {
    position: relative;
    border: 1px solid var(--edge-strong);
  }

  /* square marks on the corners of the frame */
  .pr__corner {
    position: absolute;
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid var(--edge-strong);
    background: var(--ground);
  }

  .pr__corner--tl {
    left: -0.33rem;
    top: -0.33rem;
  }

  .pr__corner--tr {
    right: -0.33rem;
    top: -0.33rem;
  }

  .pr__corner--bl {
    left: -0.33rem;
    bottom: -0.33rem;
  }

  .pr__corner--br {
    right: -0.33rem;
    bottom: -0.33rem;
  }

  .pr__top {
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 0.75rem + 2.5vw, 3rem);
    border-bottom: 1px solid var(--edge-strong);
  }

  .pr__intro {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.75rem;
  }

  .pr__name {
    font-size: var(--step-3);
  }

  .pr__tag {
    color: var(--accent-ink);
    font-weight: 500;
  }

  .pr__lede {
    color: var(--ink-2);
    max-width: 30rem;
  }

  .pr__more {
    color: var(--accent-ink);
  }

  .pr__visual {
    min-width: 0;
  }

  .pr__cells {
    display: grid;
  }

  .pr__cell {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.25rem, 0.75rem + 2.5vw, 3rem);
  }

  .pr__cell + .pr__cell {
    border-top: 1px solid var(--edge-strong);
  }

  .pr__label {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--mute);
  }

  .pr__label:not(:first-child) {
    margin-top: 0.75rem;
  }

  .pr__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .pr__chips li {
    padding: 0.4rem 0.85rem;
    border: 1px dashed var(--edge-strong);
    border-radius: var(--radius-s);
    font-size: 0.9rem;
  }

  .pr__points {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .pr__points li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    color: var(--ink-2);
  }

  .pr__check {
    width: 1rem;
    height: 1rem;
    flex: none;
    translate: 0 0.15rem;
    color: var(--accent-ink);
  }

  .pr__cell--price {
    align-content: center;
    background:
      radial-gradient(80% 100% at 100% 100%, rgb(var(--aurora-1) / 0.14), transparent 65%),
      color-mix(in oklab, var(--accent) 8%, transparent);
  }

  .pr__price {
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .pr__plan {
    color: var(--ink-2);
    max-width: 26rem;
  }

  .pr__cta {
    justify-self: start;
    margin-top: 0.5rem;
  }

  html:not(.js) .pr__tabs {
    display: none;
  }

  html:not(.js) .pr__pane[hidden] {
    display: block;
  }

  @media (min-width: 64rem) {
    .pr__top {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 3rem;
    }

    .pr__cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pr__cell + .pr__cell {
      border-top: 0;
      border-left: 1px solid var(--edge-strong);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr__pane:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import { wireTabs } from '../lib/tabs';

  wireTabs();
</script>
