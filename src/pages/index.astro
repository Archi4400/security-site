---
import Layout from '../layouts/Layout.astro';
import HeroHome from '../components/sections/HeroHome.astro';
import ProblemRows from '../components/sections/ProblemRows.astro';
import Boundary from '../components/sections/Boundary.astro';
import RuleGroups from '../components/sections/RuleGroups.astro';
import PortalShowcase from '../components/sections/PortalShowcase.astro';
import StandNumbers from '../components/sections/StandNumbers.astro';
import DiffGrid from '../components/sections/DiffGrid.astro';
import Limits from '../components/sections/Limits.astro';
import CompareTable from '../components/sections/CompareTable.astro';
import CloseCall from '../components/sections/CloseCall.astro';
---

<Layout metaKey="meta.home" path="/">
  <HeroHome />
  <ProblemRows />
  <Boundary />
  <RuleGroups />
  <PortalShowcase cycle={30} />
  <StandNumbers />
  <DiffGrid />
  <Limits />
  <CompareTable />
  <CloseCall />
</Layout>
