---
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';
import Icon from '../components/Icon.astro';
import { t, text } from '../engine';
---

<Layout metaKey="meta.notFound" path="/404" noindex>
  <section class="nf">
    <Aurora intensity={0.75} scale={12} lean={0.05} rise={1.05} />
    <div class="shell nf__wrap">
      <p class="nf__code mono" aria-hidden="true">404</p>
      <h1 class="nf__title" {...text('notFound.title')}>{t('notFound.title')}</h1>
      <p class="lede" {...text('notFound.lede')}>{t('notFound.lede')}</p>
      <a href="/" class="btn btn--solid"><span {...text('notFound.home')}>{t('notFound.home')}</span><Icon name="arrow" /></a>
    </div>
  </section>
</Layout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--header-h) - 2.75rem);
    padding-block: 4rem;
  }

  .nf__wrap {
    display: grid;
    justify-items: start;
    gap: 1.2rem;
  }

  .nf__code {
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    background: linear-gradient(100deg, rgb(var(--aurora-1)), rgb(var(--aurora-2)), rgb(var(--aurora-3)));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .nf__title {
    font-size: var(--step-4);
  }
</style>
