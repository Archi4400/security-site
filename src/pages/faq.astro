---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/sections/PageHead.astro';
import Icon from '../components/Icon.astro';
import { reveal, t, text } from '../engine';
import { faqEn } from '../i18n/locales/faq-en';
---

<Layout metaKey="meta.faq" path="/faq">
  <PageHead titleKey="faqPage.head.title" ledeKey="faqPage.head.lede" kickerKey="nav.about" />

  <section class="band fq">
    <div class="shell fq__wrap">
      <div class="fq__list">
        {faqEn.items.map((_, i) => (
          <details class="fq__item" {...reveal()}>
            <summary class="fq__q">
              <span {...text(`faq.items.${i}.q`)}>{t(`faq.items.${i}.q`)}</span>
              <Icon name="plus" class="fq__mark" />
            </summary>
            <p class="fq__a" {...text(`faq.items.${i}.a`)}>{t(`faq.items.${i}.a`)}</p>
          </details>
        ))}
      </div>
      <div class="fq__more" {...reveal()}>
        <h2 {...text('faqPage.more')}>{t('faqPage.more')}</h2>
        <a href="/contact" class="btn btn--solid"><span {...text('common.contact')}>{t('common.contact')}</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .fq__wrap {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .fq__list {
    display: grid;
  }

  .fq__item {
    border-top: 1px solid var(--edge);
  }

  .fq__item:last-child {
    border-bottom: 1px solid var(--edge);
  }

  .fq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 1.1rem;
    font-size: var(--step-1);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .fq__q::-webkit-details-marker {
    display: none;
  }

  .fq__mark {
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
    transition: rotate 0.3s var(--ease);
  }

  .fq__item[open] .fq__mark {
    rotate: 45deg;
  }

  .fq__q:hover {
    color: var(--accent-ink);
  }

  .fq__a {
    max-width: 48rem;
    padding-bottom: 1.4rem;
    color: var(--ink-2);
  }

  .fq__more {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--edge);
    background: var(--sheet);
  }

  .fq__more h2 {
    font-size: var(--step-2);
  }

  @media (min-width: 64rem) {
    .fq__wrap {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .fq__more {
      position: sticky;
      top: calc(var(--pinned-offset) + 2rem);
    }
  }
</style>
