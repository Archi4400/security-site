---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/sections/PageHead.astro';
import RequestForm from '../components/sections/RequestForm.astro';
import Icon from '../components/Icon.astro';
import { reveal, t, text } from '../engine';
import { LEGAL_EMAIL, PRESS_EMAIL, SUPPORT_EMAIL } from '../brand';

const direct = [
  { key: 'contact.support', mail: SUPPORT_EMAIL },
  { key: 'contact.legal', mail: LEGAL_EMAIL },
  { key: 'contact.pressMail', mail: PRESS_EMAIL },
];
---

<Layout metaKey="meta.contact" path="/contact">
  <PageHead titleKey="contact.head.title" ledeKey="contact.head.lede" />
  <section class="band ct">
    <div class="shell ct__grid">
      <div class="ct__form panel" {...reveal()}>
        <RequestForm />
      </div>
      <aside class="ct__side" {...reveal()}>
        <h2 class="ct__title" {...text('contact.direct')}>{t('contact.direct')}</h2>
        <ul class="ct__list" role="list">
          {direct.map((d) => (
            <li class="ct__item">
              <span class="ct__label" {...text(d.key)}>{t(d.key)}</span>
              <a href={`mailto:${d.mail}`} class="ct__mail"><Icon name="arrow" /><span>{d.mail}</span></a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .ct__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .ct__form {
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
    min-width: 0;
  }

  .ct__side {
    display: grid;
    gap: 1.25rem;
  }

  .ct__title {
    font-size: var(--step-2);
  }

  .ct__list {
    display: grid;
    margin: 0;
  }

  .ct__item {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--edge);
    min-width: 0;
  }

  .ct__label {
    color: var(--mute);
    font-size: 0.86rem;
  }

  .ct__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .ct__mail svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--accent-ink);
    transition: translate 0.2s var(--ease);
  }

  .ct__mail:hover svg {
    translate: 3px 0;
  }

  @media (min-width: 64rem) {
    .ct__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
</style>
