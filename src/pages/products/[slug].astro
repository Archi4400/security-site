---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/sections/PageHead.astro';
import LinkCards from '../../components/sections/LinkCards.astro';
import Related from '../../components/sections/Related.astro';
import CloseCall from '../../components/sections/CloseCall.astro';
import Icon from '../../components/Icon.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import NightExport from '../../components/sections/NightExport.astro';
import { reveal, t, text } from '../../engine';
import { en } from '../../i18n/locales/en';
import { DEMO } from '../../components/header/navRoutes';
import { productCards, products, type Product } from '../../lib/products';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const k = product.key;
const built = en.products[k].built;
const points = en.products[k].points;
---

<Layout metaKey={`meta.${k}`} path={`/products/${product.slug}`}>
  <PageHead titleKey={`products.${k}.name`} ledeKey={`products.${k}.lede`} kickerKey="nav.products">
    <div class="pd__actions">
      <a href={DEMO} class="btn btn--solid"><span {...text('common.cta')}>{t('common.cta')}</span></a>
      <a href={`/pricing#${k}`} class="btn btn--line"><span {...text('products.pricing')}>{t('products.pricing')}</span></a>
    </div>
  </PageHead>

  <section class="band">
    <div class="shell split" style="--split: 1fr 1.1fr">
      <div class="pd__copy">
        <div class="pd__built" {...reveal()}>
          <h2 class="pd__label" {...text('products.built')}>{t('products.built')}</h2>
          <ul class="pd__chips" role="list">
            {built.map((_, i) => (
              <li class="pd__chip" {...text(`products.${k}.built.${i}`)}>{t(`products.${k}.built.${i}`)}</li>
            ))}
          </ul>
        </div>

        <div class="pd__helps">
          <h2 class="pd__label" {...reveal()} {...text('products.helps')}>{t('products.helps')}</h2>
          <ul class="pd__points" role="list">
            {points.map((_, i) => (
              <li class="pd__point" {...reveal()} style={`--d: ${i * 0.08}s`}>
                <Icon name="check" class="pd__check" />
                <div>
                  <h3 class="pd__point-title" {...text(`products.${k}.points.${i}.title`)}>{t(`products.${k}.points.${i}.title`)}</h3>
                  <p class="pd__point-text" {...text(`products.${k}.points.${i}.text`)}>{t(`products.${k}.points.${i}.text`)}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="pin" {...reveal()}>
        <ProductVisual k={k} data-lean style="--lean-amount: 0.5" />
      </div>
    </div>
  </section>

  {/* manga watches the same CRM activity: the night export, played through */}
  {k === 'manga' && <NightExport />}

  <Related titleKey="common.relatedProducts">
    <LinkCards items={productCards(k)} />
  </Related>

  <CloseCall />
</Layout>

<style>
  .pd__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .pd__copy {
    display: grid;
    gap: 2.5rem;
  }

  .pd__built,
  .pd__helps {
    display: grid;
    gap: 1rem;
  }

  .pd__label {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--mute);
  }

  .pd__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .pd__chip {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--edge-strong);
    background: var(--sheet);
    font-size: 0.92rem;
  }

  .pd__points {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .pd__point {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--edge);
  }

  .pd__check {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    color: var(--accent-ink);
  }

  .pd__point-title {
    font-size: var(--step-1);
    margin-bottom: 0.35rem;
  }

  .pd__point-text {
    color: var(--ink-2);
  }
</style>
